{
    "name": "struktal/struktal",
    "description": "Powerful and feature-rich PHP framework designed to simplify web development",
    "version": "dev-latest",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",

        "struktal/struktal-core": "^1.0.2"
    },
    "require-dev": {
        "struktal/struktal-dev-core": "^1.1.0"
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f docker-compose-dev.yml up --build"
        ],
        "test": "vendor/bin/pest tests"
    }
}
