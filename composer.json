{
    "name": "struktal/struktal",
    "description": "Powerful and feature-rich PHP struktal designed to simplify web development",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "eftec/bladeone": "4.13.*",
        "phpmailer/phpmailer": "~v6.9.1",
        "struktal/curl-adapter": "~1.1.0",
        "struktal/geocoding-util": "~1.0.0",
        "struktal/uploadhelper": "~1.0.0",
        "struktal/csvreader": "~1.0.0",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-apcu": "*"
    },
    "require-dev": {
        "pestphp/pest": "~2.33.4"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "vendor-dir": "vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f docker-compose-dev.yml up --build"
        ],
        "test": "vendor/bin/pest tests",
        "build": "struktal/src/lib/build/build.sh",
        "tailwindcss": "struktal/src/lib/tailwindcss/tailwindcss.sh",
        "tailwindcss-compile": "struktal/src/lib/tailwindcss/tailwindcss.sh --input src/static/css/base.css --output src/static/css/style.css --minify"
    }
}
