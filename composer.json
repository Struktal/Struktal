{
    "name": "struktal/struktal",
    "description": "Powerful and feature-rich PHP framework designed to simplify web development",
    "version": "dev-latest",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",

        "struktal/struktal-core": "^1.0.3"
    },
    "require-dev": {
        "struktal/struktal-dev-core": "^1.1.0"
    },
    "config": {
        "vendor-dir": "vendor",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "struktal\\core\\StruktalDevCoreInitializer::installPlaywrightDependencies"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f docker-compose-dev.yml up --build"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "docker compose -f docker-compose-test.yml up -d --build",
            "vendor/bin/pest",
            "docker compose -f docker-compose-test.yml down"
        ]
    }
}
